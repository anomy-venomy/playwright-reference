{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Employee response",
  "type": "object",
  "required": ["data"],
  "properties": {
    "data": { "$ref": "#/definitions/employee" }
  },
  "definitions": {
    "ref": {
      "type": "object",
      "required": ["id", "name"],
      "properties": { "id": { "type": "integer" }, "name": { "type": "string" } }
    },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "employee": {
      "type": "object",
      "required": [
        "id",
        "employeeCode",
        "firstName",
        "lastName",
        "fullName",
        "email",
        "phone",
        "dateOfBirth",
        "gender",
        "department",
        "role",
        "employmentType",
        "joiningDate",
        "salary",
        "status",
        "address",
        "country",
        "state",
        "city",
        "pincode",
        "skills",
        "emergencyContactName",
        "emergencyContactPhone",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "employeeCode": { "type": "string", "pattern": "^EMP-\\d{4,6}$" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "dateOfBirth": { "$ref": "#/definitions/date" },
        "gender": { "enum": ["MALE", "FEMALE", "OTHER"] },
        "avatarUrl": { "type": ["string", "null"] },
        "department": { "$ref": "#/definitions/ref" },
        "role": { "$ref": "#/definitions/ref" },
        "employmentType": { "enum": ["FULL_TIME", "PART_TIME", "CONTRACT"] },
        "joiningDate": { "$ref": "#/definitions/date" },
        "salary": { "type": "integer", "minimum": 10000 },
        "status": { "enum": ["ACTIVE", "INACTIVE"] },
        "manager": { "type": ["object", "null"] },
        "address": { "type": "string" },
        "country": { "type": "string" },
        "state": { "type": "string" },
        "city": { "type": "string" },
        "pincode": { "type": "string" },
        "skills": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "emergencyContactName": { "type": "string" },
        "emergencyContactPhone": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    }
  }
}
