# Copy this file to env/.env.local for local runs (git-ignored). Never commit real credentials.
UI_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000/api
TEST_USER_EMAIL=your_user@example.com
TEST_USER_PASSWORD=your_password
TEST_USER_NAME=your_username
HEADLESS=true
LOG_LEVEL=debug

# Auddia stage (optional – Auddia tests only run when these are set)
AUDDIA_UI_URL=https://staging.discovrradio.com
AUDDIA_API_URL=https://api.cfr-ams-staging.auddia.services/api
AUDDIA_EMAIL=your_auddia_test_user@example.com
AUDDIA_PASSWORD=your_password