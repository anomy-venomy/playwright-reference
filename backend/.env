# SQLite database file (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Secret used to sign JWT session tokens. Use a long random string.
JWT_SECRET=****

# API server port
PORT=4000

# Origin of the frontend (used for CORS when not using the Vite proxy)
CLIENT_ORIGIN="http://localhost:5173"

# development | production
NODE_ENV=development
